  "proposed_rules": [
    {
      "id": "C02-R1-P01",
      "kind": "fact plus bounded adoption",
      "rule": "Explicit token type wins. For an untyped whole-token alias use resolved target type; for a literal inherit nearest group type; never infer from value shape. Mark parent-type/alias-target conflicts unresolved until policy is stated.",
      "sources": [
        "C02-R1-S01"
      ],
      "sections": [
        "5.2.2",
        "6.7.3"
      ],
      "cases": [
        "valid-explicit",
        "valid-group-inheritance",
        "valid-alias-inference",
        "invalid-missing-type",
        "hold-alias-parent-conflict"
      ]
    },
    {
      "id": "C02-R1-P02",
      "kind": "fact",
      "rule": "Curly braces address a complete token, not a component or group. Resolve chains and report missing targets, cycles, malformed aliases and type mismatch.",
      "sources": [
        "C02-R1-S01"
      ],
      "sections": [
        "7.1.1",
        "7.2.2",
        "7.2.3",
        "7.4.5"
      ],
      "cases": [
        "valid-chain",
        "missing-reference",
        "cycle",
        "self-cycle",
        "type-mismatch",
        "invalid-group-target",
        "invalid-property-target"
      ]
    },
    {
      "id": "C02-R1-P03",
      "kind": "project policy",
      "rule": "Reject $ref, $extends, composite types and external references with unsupported diagnostics before interpreting their contents. Unsupported is distinct from invalid DTCG. Do not silently ignore unknown semantic constructs.",
      "sources": [
        "C02-R1-S01"
      ],
      "sections": [
        "6.4",
        "7.1.2",
        "7.3"
      ],
      "cases": [
        "unsupported-property-ref",
        "unsupported-extension",
        "unsupported-composite",
        "unsupported-external-ref"
      ]
    },
    {
      "id": "C02-R1-P04",
      "kind": "fact plus subset policy",
      "rule": "Color values are structured. Numeric sRGB subset requires three numeric components in [0,1], alpha in [0,1] default 1, optional six-digit hex fallback. Other valid spaces or none remain unsupported, not invalid.",
      "sources": [
        "C02-R1-S03"
      ],
      "sections": [
        "4.1",
        "4.1.1",
        "4.2.1"
      ],
      "cases": [
        "valid-srgb",
        "invalid-color-string",
        "invalid-alpha",
        "invalid-srgb-range",
        "unsupported-none",
        "unsupported-p3",
        "invalid-fallback-hex"
      ]
    },
    {
      "id": "C02-R1-P05",
      "kind": "fact",
      "rule": "Dimension uses numeric value and px/rem unit, including unit at zero. Duration uses numeric value and ms/s. Boolean is not a numeric value. These sections do not state a general nonnegative constraint.",
      "sources": [
        "C02-R1-S01"
      ],
      "sections": [
        "8.2",
        "8.2.1",
        "8.5",
        "8.5.1"
      ],
      "cases": [
        "valid-rem",
        "invalid-zero-no-unit",
        "invalid-dimension-unit",
        "valid-seconds",
        "invalid-boolean-number",
        "negative-duration-boundary"
      ]
    },
    {
      "id": "C02-R1-P06",
      "kind": "fact plus project wrapper policy",
      "rule": "Resolve aliases after selected theme/source overrides are assembled. A custom themes wrapper may apply the same ordering principle but must not be labeled the DTCG Resolver Module.",
      "sources": [
        "C02-R1-S02"
      ],
      "sections": [
        "6.2",
        "6.3"
      ],
      "cases": [
        "theme-override",
        "theme-induced-cycle",
        "theme-type-change"
      ]
    },
    {
      "id": "C02-R1-P07",
      "kind": "project policy informed by CSS",
      "rule": "Give each exported token an injective CSS name. Reject collisions after name transformation. Specify sorting, number formatting, unit handling, selector contract, newline and all-or-nothing emission to make bytes reproducible.",
      "sources": [
        "C02-R1-S01",
        "C02-R1-S04"
      ],
      "sections": [
        "5.1",
        "CSS 2"
      ],
      "cases": [
        "name-collision",
        "case-distinct",
        "css-name-injection",
        "permuted-json-key-order"
      ]
    },
    {
      "id": "C02-R1-P08",
      "kind": "inference",
      "rule": "Resolved CSS literals can provide deterministic build artifacts but do not preserve future runtime changes to source aliases automatically. Rebuild every declared theme or use an explicitly tested runtime var graph.",
      "sources": [
        "C02-R1-S02",
        "C02-R1-S04"
      ],
      "sections": [
        "Resolver 6.3",
        "CSS 2.3",
        "CSS 3"
      ],
      "cases": [
        "theme-override",
        "runtime-base-override-limit"
      ]
    },
    {
      "id": "C02-R1-P09",
      "kind": "fact with test limit",
      "rule": "CSS custom-property cycles include dependencies inside fallbacks. var fallback only handles guaranteed-invalid/missing values, not present wrong-type values. CSS grammar failure may arise at computed-value time.",
      "sources": [
        "C02-R1-S04"
      ],
      "sections": [
        "2.3",
        "3",
        "3.1"
      ],
      "cases": [
        "css-fallback-cycle",
        "css-wrong-type-fallback"
      ]
    },
    {
      "id": "C02-R1-P10",
      "kind": "project responsibility boundary",
      "rule": "Use existing art-direction roles, paired surfaces/foregrounds and theme exports. C validates resolved path/type/coverage and output collisions; it does not invent palette/radius choices or claim visual accessibility from graph checks.",
      "sources": [
        "C02-R1-S07",
        "C02-R1-S04"
      ],
      "sections": [
        "I-01 through I-06",
        "I-14"
      ],
      "cases": [
        "theme-role-coverage",
        "rendered-contrast-hold"
      ]
    }
  ],
  "test_vectors": [
    {
      "id": "valid-explicit",
      "input": {
        "space": {
          "$type": "dimension",
          "$value": {
            "value": 6,
            "unit": "px"
          }
        }
      },
      "expected": "ACCEPT",
      "resolved": {
        "space": {
          "type": "dimension",
          "value": {
            "value": 6,
            "unit": "px"
          }
        }
      }
    },
    {
      "id": "valid-group-inheritance",
      "input": {
        "space": {
          "$type": "dimension",
          "small": {
            "$value": {
              "value": 0.25,
              "unit": "rem"
            }
          }
        }
      },
      "expected": "ACCEPT",
      "resolved_type": "dimension"
    },
    {
      "id": "valid-alias-inference",
      "input": {
        "base": {
          "$type": "duration",
          "$value": {
            "value": 0.2,
            "unit": "s"
          }
        },
        "semantic": {
          "$value": "{base}"
        }
      },
      "expected": "ACCEPT",
      "resolved_type": "duration"
    },
    {
      "id": "valid-chain",
      "input": {
        "base": {
          "$type": "dimension",
          "$value": {
            "value": 0.5,
            "unit": "rem"
          }
        },
        "semantic": {
          "$value": "{base}"
        },
        "control": {
          "$type": "dimension",
          "$value": "{semantic}"
        }
      },
      "expected": "ACCEPT",
      "resolved_value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    {
      "id": "invalid-missing-type",
      "input": {
        "x": {
          "$value": {
            "value": 5,
            "unit": "px"
          }
        }
      },
      "expected": "INVALID",
      "reason": "Value shape cannot supply missing type"
    },
    {
      "id": "missing-reference",
      "input": {
        "x": {
          "$type": "dimension",
          "$value": "{absent}"
        }
      },
      "expected": "INVALID",
      "diagnostic": "missing reference at x -> absent"
    },
    {
      "id": "self-cycle",
      "input": {
        "x": {
          "$type": "dimension",
          "$value": "{x}"
        }
      },
      "expected": "INVALID",
      "diagnostic": "cycle x -> x"
    },
    {
      "id": "cycle",
      "input": {
        "x": {
          "$value": "{y}"
        },
        "y": {
          "$value": "{z}"
        },
        "z": {
          "$value": "{x}"
        }
      },
      "expected": "INVALID",
      "diagnostic": "cycle x -> y -> z -> x"
    },
    {
      "id": "type-mismatch",
      "input": {
        "a": {
          "$type": "dimension",
          "$value": {
            "value": 8,
            "unit": "px"
          }
        },
        "b": {
          "$type": "duration",
          "$value": "{a}"
        }
      },
      "expected": "INVALID"
    },
    {
      "id": "invalid-group-target",
      "input": {
        "g": {
          "$type": "dimension",
          "x": {
            "$value": {
              "value": 8,
              "unit": "px"
            }
          }
        },
        "a": {
          "$value": "{g}"
        }
      },
