{
  "skill_id": "C-UI-209",
  "domain": "ui-engineering-design-system",
  "trigger": "階層データを矢印キーで操作するとき",
  "intent": "ツリーの展開と項目の選択を区別する",
  "required_inputs": [
    "階層",
    "展開状態",
    "選択値"
  ],
  "decision_rules": [
    "展開状態と選択状態を別に伝える。開く・閉じる・親へ移るキーと、項目を選択する操作を定める。"
  ],
  "procedure": [
    "展開状態と選択状態を別に伝える。開く・閉じる・親へ移るキーと、項目を選択する操作を定める。",
    "子に選択を残した状態で親を閉じて再展開し、現在位置・選択内容・読み上げを照合する。 見出し・リンクをたどる探索でも同じ対象へ到達できるか確認する。"
  ],
  "expected_outputs": [
    "再展開後の選択と読み上げ"
  ],
  "dependencies": [],
  "exceptions": [
    "通常のサイトナビゲーションで単純なリンク一覧が足りるときは複合ツリーを導入しない。"
  ],
  "failure_modes": [
    "親を閉じると別の項目が選択済みになる"
  ],
