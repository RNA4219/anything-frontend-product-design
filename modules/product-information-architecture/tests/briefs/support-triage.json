{
  "case_id": "support-triage",
  "roles": [
    {
      "id": "operator",
      "label": "対応担当"
    },
    {
      "id": "manager",
      "label": "管理責任者"
    }
  ],
  "goals": [
    {
      "id": "g_triage",
      "role": "operator",
      "outcome": "期限と影響を比較して次に着手する問い合わせを選ぶ",
      "priority": "must",
      "needed_information": [
        "ticket_id",
        "summary",
        "severity",
        "due_at",
        "owner",
        "status"
      ]
    },
    {
      "id": "g_assign",
      "role": "operator",
      "outcome": "選んだ問い合わせの担当を決める",
      "priority": "must",
      "needed_information": [
        "ticket_id",
        "owner",
        "assignment_policy"
      ]
    },
    {
      "id": "g_find",
      "role": "operator",
      "outcome": "解決済みを含め問い合わせの対応経緯を探す",
      "priority": "must",
      "needed_information": [
        "ticket_id",
        "status",
        "history"
      ]
    },
    {
      "id": "g_audit",
      "role": "manager",
      "outcome": "期間を指定して監査用記録を取り出す",
      "priority": "must",
      "needed_information": [
        "date_range",
        "retention",
        "export_scope"
      ]
    },
    {
      "id": "g_trends",
      "role": "manager",
      "outcome": "月別傾向を把握する",
      "priority": "should",
      "needed_information": [
        "monthly_counts"
      ]
    }
  ],
  "requirements": [
    {
      "id": "r_triage",
      "goal_ids": [
        "g_triage"
      ],
      "mandatory": true,
      "statement": "期限と影響を一覧で比較できる"
    },
    {
      "id": "r_assign",
      "goal_ids": [
        "g_assign"
      ],
      "mandatory": true,
      "statement": "担当変更機能と担当ルールを提供する"
