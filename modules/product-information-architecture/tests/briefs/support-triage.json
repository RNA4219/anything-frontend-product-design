  "visual_intent": {
    "id": "ops-charcoal-01",
    "constraints": [
      "既存の黒鉛色背景、白文字、琥珀色アクセントを維持",
      "システム書体、角丸は小さく、テキストと罫線中心",
      "Aの判断では新しい色・書体・装飾に置き換えない"
    ]
  },
  "contexts": {
    "normal": "担当者は1日に多数の問い合わせを処理する。自分の担当と全件は同じチケット集合の絞込ビュー。",
    "abnormal": "責任者のexport権限を担当者に提示しない。検索0件のとき検索条件と保持期間を確認できる。",
    "boundary": "0件/1件/10000件。責任者の監査作業は年4回。低頻度を削除理由にしない。"
  },
