{
  "case_id": "course-catalog",
  "roles": [
    {
      "id": "learner",
      "label": "受講者"
    },
    {
      "id": "editor",
      "label": "講座担当"
    }
  ],
  "goals": [
    {
      "id": "g_discover",
      "role": "learner",
      "outcome": "週末に参加できる初学者向け講座を予算内で見つける",
      "priority": "must",
      "needed_information": [
        "title",
        "level",
        "schedule",
        "price",
        "topic"
      ]
    },
    {
      "id": "g_compare",
      "role": "learner",
      "outcome": "候補講座を同じ条件で比較する",
      "priority": "must",
      "needed_information": [
        "title",
        "level",
        "schedule",
        "price",
        "prerequisites",
        "venue"
      ]
    },
    {
      "id": "g_decide",
      "role": "learner",
      "outcome": "参加条件と空席を確認して申込先へ進む",
      "priority": "must",
      "needed_information": [
        "title",
        "prerequisites",
        "seats",
        "price",
        "schedule",
        "enroll_link"
      ]
    },
    {
      "id": "g_saved",
      "role": "learner",
      "outcome": "保存した候補を後で開く",
      "priority": "should",
      "needed_information": [
        "title",
        "schedule",
        "price"
      ]
    },
    {
      "id": "g_publish",
      "role": "editor",
      "outcome": "講座情報を更新し公開する",
      "priority": "must",
      "needed_information": [
        "title",
        "publication_status"
      ]
    }
  ],
  "requirements": [
    {
      "id": "r_find",
      "goal_ids": [
        "g_discover"
      ],
      "mandatory": true,
      "statement": "トピック/レベル/日程/予算を使って同じ講座集合を探せる"
    },
    {
      "id": "r_compare",
      "goal_ids": [
        "g_compare"
      ],
      "mandatory": true,
      "statement": "2講座を同じ属性で比較し、前の画面の条件を記憶しなくてよい"
    },
    {
      "id": "r_prereq",
      "goal_ids": [
        "g_decide",
        "g_compare"
      ],
      "mandatory": true,
      "statement": "参加前提・価格（無料は0円）・空席は判断する場所で読める"
    },
    {
      "id": "r_enroll",
      "goal_ids": [
        "g_decide"
      ],
      "mandatory": true,
      "statement": "対象講座と対応する申込先がある"
    },
    {
      "id": "r_save",
      "goal_ids": [
        "g_saved"
      ],
      "mandatory": false,
      "statement": "候補保存は同じ利用者の同じ講座集合への操作"
    },
    {
      "id": "r_publish",
      "goal_ids": [
        "g_publish"
      ],
      "mandatory": true,
      "statement": "編集者用の公開機能を受講者ナビゲーションから分離する"
    }
  ],
