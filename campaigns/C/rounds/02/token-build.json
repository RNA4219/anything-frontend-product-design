  "css": "/* C-token-subset/1: resolved literals; rendering unverified. */\n:root,\n[data-theme=\"light\"] {\n  --booking-motion-feedback: 120ms;\n  --booking-palette-boundary: color(srgb 0.4 0.4 0.4 / 1);\n  --booking-palette-ink: color(srgb 0.1 0.1 0.1 / 1);\n  --booking-palette-paper: color(srgb 1 1 1 / 1);\n  --booking-semantic-controlGap: 0.75rem;\n  --booking-semantic-line: color(srgb 0.4 0.4 0.4 / 1);\n  --booking-semantic-surface: color(srgb 1 1 1 / 1);\n  --booking-semantic-text: color(srgb 0.1 0.1 0.1 / 1);\n  --booking-size-gap: 0.75rem;\n  --booking-size-line: 1px;\n}\n\n[data-theme=\"dark\"] {\n  --booking-motion-feedback: 120ms;\n  --booking-palette-boundary: color(srgb 0.4 0.4 0.4 / 1);\n  --booking-palette-ink: color(srgb 0.95 0.95 0.95 / 1);\n  --booking-palette-paper: color(srgb 0.08 0.08 0.08 / 1);\n  --booking-semantic-controlGap: 0.75rem;\n  --booking-semantic-line: color(srgb 0.4 0.4 0.4 / 1);\n  --booking-semantic-surface: color(srgb 0.08 0.08 0.08 / 1);\n  --booking-semantic-text: color(srgb 0.95 0.95 0.95 / 1);\n  --booking-size-gap: 0.75rem;\n  --booking-size-line: 1px;\n}\n",
